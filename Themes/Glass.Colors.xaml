<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design-time defaults (dark). ThemeService overwrites every key at runtime for light/dark and backdrop/no-backdrop. -->
  <SolidColorBrush x:Key="Text.Primary" Color="#F5F7FF"/><SolidColorBrush x:Key="Text.Secondary" Color="#C2C8E0"/>
  <SolidColorBrush x:Key="Glass.Fill" Color="#14FFFFFF"/><SolidColorBrush x:Key="Glass.FillHover" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="Glass.Stroke" Color="#2EFFFFFF"/><SolidColorBrush x:Key="Surface.Input" Color="#33000000"/>
  <SolidColorBrush x:Key="Surface.Popup" Color="#F21C2135"/>
  <LinearGradientBrush x:Key="Glass.Highlight" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#59FFFFFF"/><GradientStop Color="#0DFFFFFF" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="State.Success" Color="#4ADE80"/><SolidColorBrush x:Key="State.Error" Color="#F87171"/><SolidColorBrush x:Key="State.Warning" Color="#FBBF24"/>
  <SolidColorBrush x:Key="Accent" Color="#A3AFFF"/>
  <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#596BE3"/><GradientStop Color="#8752CE" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Bg.Gradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1020"/><GradientStop Color="#1B1F3A" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Bg.Tint" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1020"/><GradientStop Color="#1B1F3A" Offset="1"/></LinearGradientBrush>
</ResourceDictionary>
