<UserControl x:Class="QuickStartLauncher.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dd="urn:gong-wpf-dragdrop">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,18,0">
  <TextBlock Text="Cài đặt" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,14"/>
  <Border Style="{StaticResource GlassCard}"><StackPanel>
   <TextBlock Text="Khởi động cùng Windows" FontSize="15" FontWeight="SemiBold"/>
   <WrapPanel Margin="0,12"><RadioButton Content="Không" IsChecked="{Binding StartupOff}" GroupName="Startup"/><RadioButton Content="Tự chạy" IsChecked="{Binding StartupRun}" GroupName="Startup"/><RadioButton Content="Chỉ mở Launcher" IsChecked="{Binding StartupShow}" GroupName="Startup"/></WrapPanel>
   <StackPanel Visibility="{Binding IsAutoRun, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Profile tự chạy · kéo để sắp xếp hoặc dùng ↑ ↓" Style="{StaticResource Muted}"/>
   <ListBox x:Name="StartupList" ItemsSource="{Binding StartupProfiles}" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.UseDefaultDragAdorner="True" MaxHeight="160">
    <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <WrapPanel><Button Content="↑" Click="MoveStartupUp" AutomationProperties.Name="Profile tự chạy lên"/><Button Content="↓" Click="MoveStartupDown" AutomationProperties.Name="Profile tự chạy xuống"/></WrapPanel>
   <Grid MaxWidth="520" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Trễ sau đăng nhập (0–120s)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Trễ sau đăng nhập giây"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Đếm ngược (0–15s)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Đếm ngược giây"/></StackPanel>
   </Grid>
   </StackPanel><TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Accent}" Margin="0,4"/>
   <TextBlock Text="{Binding StartupWarning}" Foreground="{DynamicResource State.Warning}" Visibility="{Binding StartupWarning, Converter={StaticResource EmptyVisibility}, ConverterParameter=Invert}"/><TextBlock Text="{Binding UacWarning}" Foreground="{DynamicResource State.Warning}" Visibility="{Binding UacWarning, Converter={StaticResource EmptyVisibility}, ConverterParameter=Invert}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="Sau khi chạy xong" FontSize="15" FontWeight="SemiBold"/>
   <CheckBox Content="Tự đóng Launcher" IsChecked="{Binding CloseWhenDone}"/><CheckBox Content="Giữ cửa sổ khi có lỗi" IsChecked="{Binding KeepOpenOnError}"/>
   <TextBlock Text="Thời gian giữ kết quả (ms)" Style="{StaticResource FieldLabel}"/><TextBox Width="250" HorizontalAlignment="Left" Text="{Binding CloseDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Thời gian giữ kết quả"/>
   <TextBlock Text="Giao diện" Style="{StaticResource FieldLabel}"/><ComboBox Width="250" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Giao diện">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Hệ thống"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="Light"><Setter Property="Text" Value="Sáng"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Dark"><Setter Property="Text" Value="Tối"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="Cập nhật" FontSize="15" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Updates.CurrentVersionText}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
   <WrapPanel Margin="-3,0,0,0">
    <Button Content="Kiểm tra cập nhật" Command="{Binding Updates.CheckCommand}"/>
    <Button Command="{Binding Updates.InstallCommand}" Style="{StaticResource PrimaryButton}" MinHeight="34" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"><TextBlock Text="{Binding Updates.BannerText, StringFormat='Cài {0}'}" Foreground="White"/></Button>
   </WrapPanel>
   <ProgressBar Minimum="0" Maximum="1" Value="{Binding Updates.Progress}" Height="3" Margin="0,8,0,0" Width="300" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"/>
   <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
   <TextBlock Text="Ứng dụng tự kiểm tra tối đa 1 lần/ngày khi mở Launcher. Cập nhật thay thế trực tiếp file exe, không để lại file thừa." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="Dữ liệu" FontSize="15" FontWeight="SemiBold"/>
   <WrapPanel><Button Content="Thư mục config" Command="{Binding OpenConfigFolderCommand}"/><Button Content="Thư mục log" Command="{Binding OpenLogsCommand}"/><Button Content="Làm mới ứng dụng" Command="{Binding RefreshAppsCommand}"/></WrapPanel>
   <WrapPanel><Button Content="Xuất toàn bộ config…" Click="ExportConfig"/><Button Content="Nhập toàn bộ config…" Click="ImportConfig"/></WrapPanel>
   
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
