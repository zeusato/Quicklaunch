<UserControl x:Class="QuickStartLauncher.Views.Pages.ActionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:QuickStartLauncher.Views.Controls" xmlns:dd="urn:gong-wpf-dragdrop" xmlns:editors="clr-namespace:QuickStartLauncher.Views.Editors" SizeChanged="OnSizeChanged">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="EditorColumn" Width="340"/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource GlassCard}" Padding="6,8,0,8">
    <Grid>
     <ListBox x:Name="ActionList" ItemsSource="{Binding SelectedProfile.Actions}" SelectedItem="{Binding SelectedAction}" SelectionMode="Extended" SelectionChanged="ActionSelectionChanged" PreviewKeyDown="ListKeyDown" ItemContainerStyle="{StaticResource InsetItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.UseDefaultDragAdorner="True" AutomationProperties.Name="Tác vụ trong profile">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="⠿" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Cursor="SizeAll" ToolTip="Kéo để sắp xếp (hoặc Alt+↑ / Alt+↓)"/>
        <Grid Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FallbackIcon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" FontSize="20" HorizontalAlignment="Center"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" ToolTip="{Binding ValidationMessage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
        <local:ActionStatus Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ui:ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Bật / tắt mục này" AutomationProperties.Name="Bật tác vụ"/>
        <Button Grid.Column="5" Style="{StaticResource IconButton}" Click="ActionMenuClick" Margin="4,0,0,0" ToolTip="Thao tác" AutomationProperties.Name="Menu tác vụ"><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"/></Button>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding SelectedProfile.Actions.Count, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
      <TextBlock Text="Profile này chưa có mục nào" Style="{StaticResource Muted}" TextAlignment="Center" FontSize="13"/>
      <TextBlock Text="Bắt đầu bằng “Thêm ứng dụng” bên dưới." Style="{StaticResource Muted}" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <!-- Undo bar appears only right after a delete -->
   <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14,4,6,4" Margin="0,10,0,0" CornerRadius="12" Visibility="{Binding CanUndo, Converter={StaticResource BoolVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="Hoàn tác" Command="{Binding UndoCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Accent}" ToolTip="Ctrl+Z"/><TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
   </Border>
   <WrapPanel Grid.Row="2" Margin="-3,10,0,0">
    <Button Style="{StaticResource PrimaryButton}" MinHeight="38" Command="{Binding AddAppsCommand}" AutomationProperties.Name="Thêm ứng dụng"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="AppsAddIn24" FontSize="16" Margin="0,0,8,0" Foreground="White"/><TextBlock Text="Thêm ứng dụng" Foreground="White"/></StackPanel></Button>
    <Button Command="{Binding AddWebsiteCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Globe24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="Website"/></StackPanel></Button>
    <Button Command="{Binding AddCommandCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowConsole20" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="Lệnh"/></StackPanel></Button>
    <Button Command="{Binding AddDelayCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Timer24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="Chờ"/></StackPanel></Button>
   </WrapPanel>
  </Grid>
  <Border x:Name="EditorPanel" Grid.Column="1" Style="{StaticResource GlassCard}" Padding="18,14,0,14" Panel.ZIndex="2">
   <Grid>
    <DockPanel Visibility="{Binding SelectedAction, Converter={StaticResource NullVisibility}}">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,10,8" DataContext="{Binding SelectedAction}">
      <Button x:Name="CloseDrawer" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseDrawerClick" Visibility="Collapsed" ToolTip="Đóng" AutomationProperties.Name="Đóng chỉnh sửa"><ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/></Button>
      <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Accent}" Margin="0" VerticalAlignment="Center"/>
     </DockPanel>
     <Button DockPanel.Dock="Bottom" Command="{Binding TestActionCommand}" Margin="0,10,18,0" HorizontalAlignment="Stretch" ToolTip="Chạy thử mục này (bấm lần nữa để hủy)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="Chạy thử mục này"/></StackPanel></Button>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- right margin = scrollbar gutter -->
      <StackPanel DataContext="{Binding SelectedAction}" Margin="0,0,18,0">
       <TextBlock Text="Tên hiển thị" Style="{StaticResource FieldLabel}" Margin="0"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên tác vụ"/>
       <editors:AppActionEditor Visibility="{Binding IsApp, Converter={StaticResource BoolVisibility}}"/>
       <editors:WebsiteActionEditor Visibility="{Binding IsWebsite, Converter={StaticResource BoolVisibility}}"/>
       <editors:CommandActionEditor Visibility="{Binding IsCommand, Converter={StaticResource BoolVisibility}}"/>
       <editors:DelayActionEditor Visibility="{Binding IsDelay, Converter={StaticResource BoolVisibility}}"/>
       <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource State.Warning}" Margin="0,4"/>
       <TextBlock Text="KHI CHẠY" Style="{StaticResource SectionLabel}"/>
       <CheckBox Content="Bỏ qua khi tự khởi động cùng Windows" IsChecked="{Binding SkipOnAutostart}"/>
       <TextBlock Text="Chờ sau mục này (ms)" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Chờ sau tác vụ mili giây"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0" Visibility="{Binding SelectedAction, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}">
     <ui:SymbolIcon Symbol="EditSettings24" FontSize="32" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center"/>
     <TextBlock Text="Chọn một mục để chỉnh sửa" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
