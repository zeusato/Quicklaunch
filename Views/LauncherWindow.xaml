<ui:FluentWindow x:Class="QuickStartLauncher.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickStartLauncher.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="QuickStart" Width="420" SizeToContent="Height" MinHeight="320" MaxHeight="640" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" Icon="/QuickStartLauncher;component/Assets/APP.ico" PreviewKeyDown="OnKeyDown">
 <Grid Background="{DynamicResource Bg.Tint}"><Grid Margin="20,14,20,18"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Title bar: whole row drags, icon buttons are borderless so they don't compete with Begin -->
  <Grid MouseLeftButtonDown="DragTitle" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Flash24" FontSize="22" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="QuickStart" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding OpenConfigCommand}" ToolTip="Cấu hình (Ctrl+,)" AutomationProperties.Name="Cấu hình"><ui:SymbolIcon Symbol="Settings24" FontSize="18"/></Button>
   <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CloseClick" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/></Button>
  </Grid>
  <StackPanel Grid.Row="1">
   <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource State.Warning}" FontSize="11" MaxHeight="65" Margin="0,0,0,4" Visibility="{Binding Warning, Converter={StaticResource EmptyVisibility}, ConverterParameter=Invert}"/>
   <!-- Update banner: only when a newer release exists and the user hasn't dismissed it this session -->
   <Border Style="{StaticResource GlassCard}" CornerRadius="12" Padding="12,6,6,6" Margin="0,2,0,6" BorderBrush="{DynamicResource Accent}" Visibility="{Binding Updates.ShowBanner, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}">
    <StackPanel>
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding Updates.DismissCommand}" ToolTip="Để sau" AutomationProperties.Name="Để sau"><ui:SymbolIcon Symbol="Dismiss24" FontSize="12"/></Button>
      <Button DockPanel.Dock="Right" Content="Cập nhật" Command="{Binding Updates.InstallCommand}" Style="{StaticResource PrimaryButton}" MinHeight="28" Padding="12,2" Margin="6,0,2,0" FontSize="12"/>
      <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
      <TextBlock Text="{Binding Updates.BannerText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Muted}" Margin="24,2,0,0" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <ListBox Grid.Row="2" Style="{StaticResource ChipList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" Margin="0,4,0,12" IsEnabled="{Binding CanSelectProfile}" ToolTip="Phím 1–9 để chuyển profile"/>
  <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="6,8,0,8" MinHeight="120">
   <Grid>
    <ListBox ItemsSource="{Binding SelectedProfile.Actions}" Focusable="False" ItemContainerStyle="{StaticResource InsetItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid VerticalAlignment="Center"><TextBlock Text="{Binding FallbackIcon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" FontSize="20" HorizontalAlignment="Center"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
      <local:ActionStatus Grid.Column="2" VerticalAlignment="Center"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Chưa có ứng dụng nào" TextAlignment="Center" Style="{StaticResource Muted}"/><Button Content="＋ Thêm ứng dụng" Command="{Binding AddAppsCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Margin="0,16,0,0">
   <Button Content="{Binding BeginLabel}" Command="{Binding BeginCommand}" Style="{StaticResource PrimaryButton}" FontSize="16" MinHeight="48" Margin="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Bắt đầu hoặc hủy"/>
   <Button Content="↻  Thử lại mục lỗi" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
  </StackPanel>
  <StackPanel Grid.Row="5" Margin="2,12,2,0">
   <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Completed}" Height="3" Foreground="{DynamicResource Accent}" Margin="0,0,0,8" Visibility="{Binding Total, Converter={StaticResource BoolVisibility}}"/>
   <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextAlignment="Center"/>
  </StackPanel>
 </Grid>
</Grid></ui:FluentWindow>
