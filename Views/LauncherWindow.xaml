<ui:FluentWindow x:Class="QuickStartLauncher.Views.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickStartLauncher.Views.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="QuickStart" Width="440" Height="550" MinHeight="360" MaxHeight="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" Icon="/QuickStartLauncher;component/Assets/APP.ico" PreviewKeyDown="OnKeyDown">
 <Grid Background="{DynamicResource Bg.Tint}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragTitle"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="QuickStart" FontSize="22" FontWeight="SemiBold"/></StackPanel>
   <Button Grid.Column="1" Content="⚙" Command="{Binding OpenConfigCommand}" ToolTip="Cấu hình (Ctrl+,)" AutomationProperties.Name="Cấu hình"/>
   <Button Grid.Column="2" Content="✕" Click="CloseClick" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng"/>
  </Grid>
  <TextBlock Grid.Row="1" Text="{Binding Warning}" Foreground="{DynamicResource State.Warning}" FontSize="11" MaxHeight="65"/>
  <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,10" IsEnabled="{Binding CanSelectProfile}">
   <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  </ListBox>
  <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="8">
   <Grid>
    <ListBox ItemsSource="{Binding SelectedProfile.Actions}" Focusable="False">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <Grid><TextBlock Text="{Binding FallbackIcon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" FontSize="24" HorizontalAlignment="Center"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
      <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
      <local:ActionStatus Grid.Column="2"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Chưa có ứng dụng nào" TextAlignment="Center"/><Button Content="＋ Thêm ứng dụng" Command="{Binding AddAppsCommand}" Margin="20"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Margin="0,14,0,0">
   <Button Content="{Binding BeginLabel}" Command="{Binding BeginCommand}" Style="{StaticResource PrimaryButton}" FontSize="17" AutomationProperties.Name="Bắt đầu hoặc hủy"/>
   <Button Content="↻ Thử lại mục lỗi" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel>
  <StackPanel Grid.Row="5" Margin="4,10,4,0"><ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Completed}" Height="4" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</Grid></ui:FluentWindow>
