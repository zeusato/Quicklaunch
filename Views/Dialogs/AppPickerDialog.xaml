<ui:FluentWindow x:Class="QuickStartLauncher.Views.Dialogs.AppPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
 Title="Thêm ứng dụng" Width="780" Height="600" MinWidth="600" MinHeight="440" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" PreviewKeyDown="OnKeyDown">
 <Grid Background="{DynamicResource Bg.Tint}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel MouseLeftButtonDown="DragTitle"><Button DockPanel.Dock="Right" Content="✕" Click="CancelClick" AutomationProperties.Name="Đóng picker"/><TextBlock Text="Thêm ứng dụng" FontSize="24" FontWeight="SemiBold"/></DockPanel>
  <TextBox x:Name="SearchBox" Grid.Row="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Margin="0,16,0,8" AutomationProperties.Name="Tìm ứng dụng" ToolTip="Tìm tên ứng dụng, viết tắt hoặc tên gần đúng"/>
  <DockPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="Đang làm mới…" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Muted}"/>
   <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
  </DockPanel>
  <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="8">
   <ListBox x:Name="AppList" ItemsSource="{Binding Results}" MouseDoubleClick="ItemDoubleClick" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Ứng dụng Windows">
    <ListBox.ItemsPanel><ItemsPanelTemplate><vwp:VirtualizingWrapPanel ItemSize="130,132"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Width="108" Height="108" Loaded="TileLoaded">
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="34"/><RowDefinition Height="18"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="▣" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/><Image Source="{Binding Icon}" Width="48" Height="48"/>
       <CheckBox IsChecked="{Binding Selected}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" AutomationProperties.Name="{Binding Name}"/>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding Name}"/>
      <TextBlock Grid.Row="2" Text="{Binding Badge}" FontSize="10" TextAlignment="Center" Foreground="{DynamicResource Accent}"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Border>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="4,0,0,8"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hủy" Click="CancelClick"/><Button Content="{Binding AddLabel}" Click="AddClick" Style="{StaticResource PrimaryButton}"/></StackPanel>
    <WrapPanel><Button Content="Chọn file .exe…" Click="BrowseClick"/><Button Content="Lệnh tùy chỉnh" Click="CommandClick"/></WrapPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Grid></ui:FluentWindow>
