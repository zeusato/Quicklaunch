<UserControl x:Class="QuickStartLauncher.Views.Controls.ActionStatus" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Width="24" Height="24" ToolTip="{Binding Error}" AutomationProperties.Name="{Binding StatusGlyph}">
  <TextBlock x:Name="Glyph" Text="{Binding StatusGlyph}" FontSize="22" TextAlignment="Center" Foreground="{Binding State, Converter={StaticResource StateBrush}}" RenderTransformOrigin=".5,.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock>
  <Path x:Name="Check" Data="M 3,12 L 9,18 L 21,5" Stroke="{DynamicResource State.Success}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="14 14" Visibility="Collapsed"/>
 </Grid>
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers>
  <DataTrigger Binding="{Binding State}" Value="Done"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From=".3" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
 </Style.Triggers></Style></UserControl.Style>
</UserControl>
