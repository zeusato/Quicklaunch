<UserControl x:Class="QuickStartLauncher.Views.Editors.AppActionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:QuickStartLauncher.Views" xmlns:dd="urn:gong-wpf-dragdrop">
 <StackPanel>
  <TextBlock Text="Ứng dụng" Style="{StaticResource FieldLabel}"/>
  <Border Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Glass.Stroke}" BorderThickness="1" CornerRadius="10" Padding="10,6,4,6" Margin="0,4,0,8">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Đổi…" MinHeight="30" Padding="10,4" Margin="6,0,0,0" Command="{Binding DataContext.ChangeAppCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConfigWindow}}}" AutomationProperties.Name="Đổi ứng dụng"/>
    <TextBlock Text="{Binding Target}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Target}"/>
   </DockPanel>
  </Border>
  <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="TRÌNH DUYỆT" Style="{StaticResource SectionLabel}"/>
   <TextBlock Text="Profile trình duyệt" Style="{StaticResource FieldLabel}" Margin="0"/><ComboBox ItemsSource="{Binding BrowserProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Directory" SelectedValue="{Binding ProfileDir}" AutomationProperties.Name="Profile trình duyệt"/>
   <TextBlock Text="Trang mở sẵn · kéo ⠿ để đổi thứ tự" Style="{StaticResource FieldLabel}"/>
   <ListBox ItemsSource="{Binding Urls}" SelectedItem="{Binding SelectedUrl}" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.UseDefaultDragAdorner="True" MaxHeight="220" Margin="0,4,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource InsetItem}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="⠿" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Cursor="SizeAll"/>
     <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0" AutomationProperties.Name="URL"/>
     <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding DataContext.RemoveUrlCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Xóa URL" AutomationProperties.Name="Xóa URL"><ui:SymbolIcon Symbol="Dismiss24" FontSize="12"/></Button>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Grid Margin="16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0" ToolTip="Nhập URL rồi Enter" AutomationProperties.Name="URL mới">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddUrlCommand}"/></TextBox.InputBindings>
    </TextBox>
    <TextBlock Text="＋ Thêm trang, ví dụ mail.google.com" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" Visibility="{Binding NewUrl, Converter={StaticResource EmptyVisibility}}"/>
    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding AddUrlCommand}" ToolTip="Thêm URL (Enter)" AutomationProperties.Name="Thêm URL"><ui:SymbolIcon Symbol="Add24" FontSize="14"/></Button>
   </Grid>
   <CheckBox Content="Mở trong cửa sổ mới" IsChecked="{Binding NewWindow}" Margin="0,10,0,0"/>
  </StackPanel>
  <Expander Header="Nâng cao"><StackPanel Margin="0,8">
   <TextBlock Text="Tham số" Style="{StaticResource FieldLabel}" Margin="0"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SupportsArguments}" AutomationProperties.Name="Tham số ứng dụng"/>
   <TextBlock Text="Ứng dụng chỉ có AUMID không hỗ trợ tham số nếu không phải Store." Style="{StaticResource Muted}" Visibility="{Binding SupportsArguments, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
   <TextBlock Text="Thư mục làm việc" Style="{StaticResource FieldLabel}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Thư mục làm việc"/>
    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="BrowseFolder" ToolTip="Chọn thư mục…" AutomationProperties.Name="Chọn thư mục"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"/></Button>
   </Grid>
   <CheckBox Content="Chạy với quyền quản trị" IsChecked="{Binding RunAsAdmin}"/>
   <TextBlock Text="Windows sẽ hỏi quyền UAC, kể cả khi tự khởi động." Style="{StaticResource Muted}" Foreground="{DynamicResource State.Warning}" Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel></Expander>
 </StackPanel>
</UserControl>
