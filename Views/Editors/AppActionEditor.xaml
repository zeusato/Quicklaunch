<UserControl x:Class="QuickStartLauncher.Views.Editors.AppActionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:QuickStartLauncher.Views" xmlns:dd="urn:gong-wpf-dragdrop">
 <StackPanel>
  <TextBlock Text="{Binding Target}" Style="{StaticResource Muted}" MaxHeight="56"/>
  <Button Content="Đổi ứng dụng…" Command="{Binding DataContext.ChangeAppCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ConfigWindow}}}"/>
  <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="TRÌNH DUYỆT" Foreground="{DynamicResource Accent}" Margin="0,14,0,8"/>
   <TextBlock Text="Profile trình duyệt"/><ComboBox ItemsSource="{Binding BrowserProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Directory" SelectedValue="{Binding ProfileDir}" AutomationProperties.Name="Profile trình duyệt"/>
   <TextBlock Text="URL / tab · kéo để đổi thứ tự"/>
   <ListBox ItemsSource="{Binding Urls}" SelectedItem="{Binding SelectedUrl}" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.UseDefaultDragAdorner="True" MaxHeight="220">
    <ListBox.ItemTemplate><DataTemplate><DockPanel>
     <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DataContext.RemoveUrlCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Xóa URL"/>
     <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="140" AutomationProperties.Name="URL"/>
    </DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBox Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://…" AutomationProperties.Name="URL mới"/>
   <WrapPanel><Button Content="＋ Thêm URL" Command="{Binding AddUrlCommand}"/><Button Content="↑" Command="{Binding MoveUrlUpCommand}" AutomationProperties.Name="Đưa URL lên"/><Button Content="↓" Command="{Binding MoveUrlDownCommand}" AutomationProperties.Name="Đưa URL xuống"/></WrapPanel>
   <CheckBox Content="Mở cửa sổ mới" IsChecked="{Binding NewWindow}"/>
  </StackPanel>
  <Expander Header="Nâng cao"><StackPanel Margin="0,8">
   <TextBlock Text="Tham số"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SupportsArguments}" AutomationProperties.Name="Tham số ứng dụng"/>
   <TextBlock Text="Ứng dụng chỉ có AUMID không hỗ trợ tham số nếu không phải Store." Style="{StaticResource Muted}" Visibility="{Binding SupportsArguments, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
   <TextBlock Text="Thư mục làm việc"/><TextBox Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Thư mục làm việc"/>
   <Button Content="Chọn thư mục…" Click="BrowseFolder"/>
   <CheckBox Content="Chạy với quyền quản trị" IsChecked="{Binding RunAsAdmin}"/>
   <TextBlock Text="Windows sẽ hỏi quyền UAC, kể cả khi tự khởi động." Style="{StaticResource Muted}" Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolVisibility}}"/>
  </StackPanel></Expander>
 </StackPanel>
</UserControl>
