<UserControl x:Class="QuickStartLauncher.Views.Editors.WebsiteActionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:QuickStartLauncher.Views">
 <StackPanel><TextBlock Text="Địa chỉ URL" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Địa chỉ website"/>
 <TextBlock Text="Mở bằng trình duyệt" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DataContext.Browsers, RelativeSource={RelativeSource AncestorType={x:Type views:ConfigWindow}}}" SelectedValuePath="Id" SelectedValue="{Binding BrowserId}" AutomationProperties.Name="Trình duyệt cho website"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
 <CheckBox Content="Mở cửa sổ mới" IsChecked="{Binding NewWindow}"/><TextBlock Text="Với Mặc định Windows, cách mở cửa sổ do trình duyệt quyết định." Style="{StaticResource Muted}"/></StackPanel>
</UserControl>
