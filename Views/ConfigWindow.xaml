<Window x:Class="QuickStartLauncher.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickStartLauncher.Views"
        xmlns:models="clr-namespace:QuickStartLauncher.Models"
        xmlns:core="clr-namespace:QuickStartLauncher.Core"
        mc:Ignorable="d"
        Title="Configuration" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <core:IsNullOrEmptyStringConverter x:Key="IsNullOrEmptyStringConverter"/>
        <core:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Profile Selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Profile:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" 
                      SelectedItem="{Binding ActiveProfile}" MinWidth="150"/>
        </StackPanel>

        <!-- Main Content: Tab Control -->
        <TabControl Grid.Row="1">
            <TabItem Header="Actions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding ActiveProfile.Actions}" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectedItem="{Binding SelectedAction}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" MaxHeight="24" MaxWidth="24"/>
                                            <ContentControl Grid.Column="1" Content="{Binding}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActionType}" Value="App">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActionType}" Value="Command">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Details" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActionType}" Value="App">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <StackPanel>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                                                <Button Grid.Column="1"
                                                                                        Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button">
                                                                                            <Setter Property="Content" Value="Browse..."/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Path, Converter={StaticResource IsNullOrEmptyStringConverter}}" Value="False">
                                                                                                    <Setter Property="Content" Value="Change"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </Grid>
                                                                            <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" ToolTip="Default URL"/>
                                                                                <CheckBox IsChecked="{Binding NewWindow}" Content="Open in new window" Margin="0,5,0,0"/>
                                                                            </StackPanel>
                                                                            <Expander Header="Advanced" Margin="0,5,0,0">
                                                                                <StackPanel>
                                                                                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="Arguments"/>
                                                                                    <CheckBox IsChecked="{Binding RunAsAdmin}" Content="Run as administrator"/>
                                                                                </StackPanel>
                                                                            </Expander>
                                                                            <TextBlock Text="{Binding Description}" Foreground="Gray" FontStyle="Italic" Margin="0,5,0,0"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ActionType}" Value="Command">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ComboBox Grid.Column="0" ItemsSource="{core:EnumValues {x:Type models:ShellType}}"
                                                                                      SelectedItem="{Binding Shell}" Margin="0,0,5,0"/>
                                                                            <TextBox Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="Add Action" Command="{Binding AddActionCommand}" Margin="0,0,5,0"/>
                        <Button Content="Remove Action" Command="{Binding RemoveActionCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Profiles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectedItem="{Binding SelectedProfileForEditing}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile Name" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="Add Profile" Command="{Binding AddProfileCommand}" Margin="0,0,5,0"/>
                        <Button Content="Remove Profile" Command="{Binding RemoveProfileCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Bar: Save/Cancel Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Padding="20,5" Margin="0,0,10,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Padding="20,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>