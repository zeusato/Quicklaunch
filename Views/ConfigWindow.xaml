<ui:FluentWindow x:Class="QuickStartLauncher.Views.ConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:QuickStartLauncher.Views.Pages"
 Title="QuickStart · Cấu hình" Width="1120" Height="740" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" Icon="/QuickStartLauncher;component/Assets/APP.ico" PreviewKeyDown="OnKeyDown">
 <Grid Background="{DynamicResource Bg.Tint}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragTitle"><TextBlock Text="ϟ  QuickStart / Cấu hình" FontSize="20" FontWeight="SemiBold"/><Button Content="✕" HorizontalAlignment="Right" Click="CloseClick" AutomationProperties.Name="Đóng cấu hình"/></Grid>
  <TextBlock Grid.Row="1" Text="{Binding Warning}" Foreground="{DynamicResource State.Warning}" MaxHeight="70"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource GlassCard}" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="PROFILES" Style="{StaticResource Muted}" Margin="8,8,0,12"/>
      <TextBox x:Name="ProfileName" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên profile" ToolTip="Đổi tên profile"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button Content="＋ Profile" Command="{Binding AddProfileCommand}"/>
      <Button Content="Nhân bản" Command="{Binding DuplicateProfileCommand}"/>
      <Button Content="Đặt làm mặc định" Command="{Binding SetDefaultCommand}"/>
      <WrapPanel><Button Content="Nhập" Click="ImportProfileClick"/><Button Content="Xuất" Click="ExportProfileClick"/><Button Content="Xóa" Click="DeleteProfileClick"/></WrapPanel>
      <TextBlock Text="Biểu tượng profile" Style="{StaticResource Muted}" Margin="4,10,0,0"/><TextBox Text="{Binding SelectedProfile.Icon, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Biểu tượng profile"/><Separator Margin="0,8"/>
      <Button Content="⚙  Cài đặt" Click="SettingsClick"/>
     </StackPanel>
     <ListBox PreviewMouseRightButtonDown="SelectProfileContext" ContextMenuOpening="ProfileContextOpening" PreviewMouseLeftButtonUp="ProfileClick" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" AutomationProperties.Name="Danh sách profile"><ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu></ListBox>
    </DockPanel>
   </Border>
   <pages:ActionsPage x:Name="ActionsPage" Grid.Column="2" Visibility="{Binding ShowSettings, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
   <pages:SettingsPage Grid.Column="2" Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" DataContext="{Binding Settings}"/>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="QUICKSTART 3.0" Style="{StaticResource Muted}" DockPanel.Dock="Left"/><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Muted}" TextAlignment="Right" ToolTip="{Binding SaveStatus}"/></DockPanel>
 </Grid>
</Grid></ui:FluentWindow>
