<ui:FluentWindow x:Class="QuickStartLauncher.Views.ConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:pages="clr-namespace:QuickStartLauncher.Views.Pages"
 Title="QuickStart · Cấu hình" Width="1120" Height="740" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" Icon="/QuickStartLauncher;component/Assets/APP.ico" PreviewKeyDown="OnKeyDown">
 <Grid Background="{DynamicResource Bg.Tint}"><Grid Margin="20,12,20,12"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragTitle" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="QuickStart" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  /  Cấu hình" FontSize="17" Style="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
   <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="CloseClick" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng cấu hình"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/></Button>
  </Grid>
  <TextBlock Grid.Row="1" Text="{Binding Warning}" Foreground="{DynamicResource State.Warning}" MaxHeight="70" Margin="0,0,0,6"/>
  <Grid Grid.Row="2" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <!-- Sidebar: only navigation. Profile editing lives in the content header. -->
   <Border Style="{StaticResource GlassCard}" Padding="10,12,0,10">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="PROFILES" Style="{StaticResource SectionLabel}" Margin="10,2,0,8"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,10,0">
      <Button Style="{StaticResource GhostButton}" Command="{Binding AddProfileCommand}" AutomationProperties.Name="Thêm profile"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Profile mới"/></StackPanel></Button>
      <Separator Margin="4,6" Opacity=".4"/>
      <Button Style="{StaticResource GhostButton}" Click="SettingsClick" AutomationProperties.Name="Cài đặt"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Cài đặt"/></StackPanel></Button>
     </StackPanel>
     <ListBox PreviewMouseRightButtonDown="SelectProfileContext" ContextMenuOpening="ProfileContextOpening" PreviewMouseLeftButtonUp="ProfileClick" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemContainerStyle="{StaticResource InsetItem}" AutomationProperties.Name="Danh sách profile" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Icon}" Width="26" FontSize="15" FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2" Visibility="{Binding ShowSettings, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <!-- Profile header: icon + editable name, secondary actions in ⋯, primary action on the right -->
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding SelectedProfile.Icon, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Width="48" FontSize="18" FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI" HorizontalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Biểu tượng profile (emoji)" AutomationProperties.Name="Biểu tượng profile"/>
     <TextBox x:Name="ProfileName" Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Background="Transparent" BorderBrush="Transparent" Margin="0" ToolTip="Bấm để đổi tên profile" AutomationProperties.Name="Tên profile"/>
     <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="ProfileMenuClick" ToolTip="Thao tác profile" AutomationProperties.Name="Thao tác profile" Margin="8,0"><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18"/></Button>
     <Button Grid.Column="3" Command="{Binding TestProfileCommand}" Margin="0" ToolTip="Chạy thử toàn bộ profile (bấm lần nữa để hủy)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="Chạy thử profile"/></StackPanel></Button>
    </Grid>
    <pages:ActionsPage x:Name="ActionsPage" Grid.Row="1"/>
   </Grid>
   <pages:SettingsPage Grid.Column="2" Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" DataContext="{Binding Settings}"/>
  </Grid>
  <DockPanel Grid.Row="3" Margin="2,6,2,0"><TextBlock Text="{Binding Settings.Updates.CurrentVersionText, FallbackValue=QuickStart}" Style="{StaticResource Muted}" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding SaveStatus}"/></DockPanel>
 </Grid>
</Grid></ui:FluentWindow>
