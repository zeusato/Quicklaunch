<ui:FluentWindow x:Class="QuickStartLauncher.Views.AutostartToast" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="QuickStart · Tự khởi động" Width="420" Height="200" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round">
 <Grid Background="{DynamicResource Bg.Tint}"><StackPanel Margin="20,16,20,16">
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="QUICKSTART" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Accent}" Margin="0" VerticalAlignment="Center"/></StackPanel>
  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,8" MaxHeight="40"/>
  <DockPanel Margin="-3,4,0,0"><Button DockPanel.Dock="Right" Content="Mở Launcher" Command="{Binding OpenLauncherCommand}" Style="{StaticResource GhostButton}"/><Button Content="Đóng" Command="{Binding CancelCommand}" MinWidth="72" HorizontalAlignment="Left"/></DockPanel>
 </StackPanel></Grid>
</ui:FluentWindow>
